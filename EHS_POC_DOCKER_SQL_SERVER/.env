# EHS AI POC - Environment Configuration

# REQUIRED: Groq API Key
# Get free key at: https://console.groq.com
GROQ_API_KEY="PUT Your GROQ API Key here"

# Optional: Model Configuration
GROQ_MODEL=openai/gpt-oss-120b
# Alternatives: mixtral-8x7b-32768, gemma2-9b-it

# App Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
REPORTS_DIR=/app/reports
KNOWLEDGE_BASE_DIR=./knowledge_base
CHROMA_DB_DIR=./data/chroma_db

# CV Model Configuration
# YOLOv8 model size: n (nano), s (small), m (medium)
# Use 'n' for laptops with limited resources
YOLO_MODEL_SIZE=s
CONFIDENCE_THRESHOLD=0.25
PERSON_MODEL_PATH=/app/models/yolov8s.pt
PPE_MODEL_PATH=/app/models/ppe_detection.pt

# Add these to your existing .env.example
MSSQL_SERVER=sqlserver
MSSQL_PORT=1433
MSSQL_DATABASE=ehs_db
MSSQL_USER=sa
MSSQL_PASSWORD=EHS_Strong_Pass1!    

# get custom yolo model from here: 
# ppe detection: https://huggingface.co/Tanishjain9/yolov8n-ppe-detection-6classes 
